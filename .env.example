# ============================================================
# IMAP & Customer API Server Environment Configuration
# ============================================================

# Server Port
PORT=8080

# ------------------------------------------------------------
# Customer Info Endpoint Security Credentials (MANDATORY)
# ------------------------------------------------------------
# Standard API key for customer lookup (GET /api/customer/info)
# Enforces data minimization (masked email/phone, no device fingerprints)
CUSTOMER_API_KEY=your_secure_customer_api_key_here

# Administrative key required for bulk queries (?all=true) & full unmasked PII
ADMIN_API_KEY=your_secure_admin_api_key_here

# ------------------------------------------------------------
# Distributed Rate Limiting (Upstash Redis / Vercel KV)
# ------------------------------------------------------------
# Required for serverless rate limiting (30 requests/min per IP)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Optional: Vercel KV fallback variable names (if using Vercel KV integration)
# KV_REST_API_URL=https://your-kv-instance.vercel-storage.com
# KV_REST_API_TOKEN=your_vercel_kv_token_here

# ------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------
# Comma-separated list of allowed caller origins (defaults include owner domains)
ALLOWED_ORIGINS=https://dealsbyshiv.web.app,https://ff-store-4a61e.web.app,https://dealsbyshiv.firebaseapp.com,https://ff-store-4a61e.firebaseapp.com

# ------------------------------------------------------------
# OTP Service & Legacy API Secret Key
# ------------------------------------------------------------
API_SECRET_KEY=your_garena_otp_secret_key_here

# ------------------------------------------------------------
# Firebase Admin Credentials (Raw JSON String or Service Account file)
# ------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ff-store-4a61e",...}

# ------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ------------------------------------------------------------
# Google & Zoho OAuth API Credentials
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
